// oxidhome.wit
//
// Plugin interface for OxidHome. Source of truth for the host/plugin
// contract; everything else generates code from this file.
//
// The contract is split into focused interfaces. Plugins compose what they
// need by importing the appropriate world.
//
// Four plugin worlds are defined:
//   - plugin              — standard device integrations and automations
//   - streaming-plugin    — adds host-media + WASI sockets/HTTP for long-lived I/O
//   - ai-plugin           — adds inference for ML-driven plugins
//   - streaming-ai-plugin — combines streaming + inference
//
// ── Capability gating ────────────────────────────────────────────────────
// Importing an interface does NOT grant access to it. A component built for
// the `plugin` world MUST satisfy every world import — the host cannot
// refuse to link an import without making the component fail to instantiate
// outright. Capability enforcement therefore happens at the **call site**:
// every host call goes through a permission gate that consults the manifest
// the user approved at install time, and unauthorized calls return
// `error::permission-denied(...)`. Manifests, gating policy, and the audit
// trail live in oxidhome-core.

package oxidhome:plugin@0.1.0;


// ─────────────────────────────────────────────────────────────────────────
// Shared types
// ─────────────────────────────────────────────────────────────────────────

interface types {
  /// Wall-clock milliseconds since the Unix epoch. Use this for anything
  /// that crosses process or system boundaries (events, persisted records,
  /// correlations with external systems).
  type unix-ms = u64;

  /// Monotonic milliseconds since plugin instance start. Use this for
  /// measuring durations and intervals within a single plugin run; values
  /// are not comparable across restarts or with other clocks.
  type monotonic-ms = u64;

  /// Stable identifier for a device within the host's device registry.
  /// Assigned by the host when the plugin registers a device.
  type device-id = string;

  /// Plugin-instance-local identifier the plugin uses to refer to its own
  /// devices before/after registration.
  type local-id = string;

  /// Stable identifier for a service within the host's service registry
  /// (Phase 7). Assigned by the host when the plugin registers a service.
  /// Distinct id-space from `device-id` (the host mints `svc-N`).
  type service-id = string;

  type subscription-id = u64;

  /// Host-minted identifier for one device command dispatch (H5),
  /// `cmd-<32 hex>`. Unique per dispatch: a retry of the same request
  /// is a new command with a new id. Quoted by the plugin in
  /// `host-devices::complete-command` and recorded in the host's
  /// audit trail.
  type command-id = string;

  variant value {
    bool-val(bool),
    int-val(s64),
    float-val(f64),
    string-val(string),
    bytes-val(list<u8>),
    /// Structured data, JSON-encoded. Use sparingly; prefer typed records.
    json-val(string),
  }

  record key-value {
    key: string,
    value: value,
  }

  variant error {
    not-found(string),
    invalid-argument(string),
    permission-denied(string),
    unavailable(string),
    internal(string),
  }
}


// ─────────────────────────────────────────────────────────────────────────
// Capabilities — the reusable units that devices compose from
//
// Capability *spec* (what a device CAN do) is separated from capability
// *state* (what its current state is). Devices register a list of specs;
// state flows through events.
// ─────────────────────────────────────────────────────────────────────────

interface capabilities {
  /// Discrete on/off state.
  record switchable {
    state: bool,
  }

  /// 0.0–1.0 continuous level (brightness, fan speed, blind position).
  record dimmable {
    level: f64,
  }

  /// Color in HSV (each 0.0–1.0) plus optional color temperature in Kelvin.
  record color {
    hue: f64,
    saturation: f64,
    value: f64,
    color-temp-kelvin: option<u32>,
  }

  /// Unit of a numeric sensor reading. The named cases are the
  /// contract: consumers may convert, compare, and aggregate readings
  /// by unit. Each case's kebab-case name is also its stable code in
  /// the host's state projection (`"celsius"`, `"kilowatt-hour"`, ...).
  variant unit {
    /// Dimensionless count or index (e.g. UV index, people count).
    unitless,
    percent,
    celsius,
    fahrenheit,
    kelvin,
    lux,
    watt,
    kilowatt,
    watt-hour,
    kilowatt-hour,
    volt,
    ampere,
    hertz,
    pascal,
    hectopascal,
    /// Parts per million.
    ppm,
    /// Parts per billion.
    ppb,
    microgram-per-cubic-meter,
    millimeter,
    meter,
    meter-per-second,
    liter,
    cubic-meter,
    gram,
    kilogram,
    second,
    /// Plane angle in degrees (wind direction, tilt).
    degree,
    decibel,
    /// Signal power in decibel-milliwatts.
    dbm,
    /// Escape hatch for a quantity the named set doesn't cover. The
    /// payload is a display label only and is NOT part of the
    /// contract: consumers must not parse, convert, or compare it.
    /// The host refuses a label that spells a named unit's code.
    other(string),
  }

  /// Numeric reading with a unit.
  record measurement {
    value: f64,
    unit: unit,
  }

  /// A button press / scene-controller event. Stateless; only delivered
  /// as events, never queried.
  variant button-event {
    pressed,
    released,
    single-press,
    double-press,
    long-press,
    /// Rotational delta; positive values are clockwise.
    rotated(f64),
  }

  /// Spec hints for a color-capable light: which color models the device
  /// supports and the Kelvin range when color-temp is supported.
  record color-light-spec {
    /// Whether full HSV control is supported.
    supports-hsv: bool,
    /// Whether color-temperature control is supported.
    supports-color-temp: bool,
    /// Kelvin range when supports-color-temp is true. None on either side
    /// means "unspecified".
    color-temp-min-kelvin: option<u32>,
    color-temp-max-kelvin: option<u32>,
  }

  /// Spec for a sensor: unit and reasonable display range.
  record sensor-spec {
    /// Unit every reading of this sensor carries. The host refuses an
    /// `initial-state` measurement whose unit differs. Every sensor
    /// `state-change` / `ok-with-state` must carry a `unit` field with
    /// this unit's code (plus `unit_label` with the label, for
    /// `other`); the host refuses one that omits or contradicts them.
    unit: unit,
    /// Optional reasonable range for UIs and validation. Both bounds
    /// must be finite, and `min <= max` when both are set.
    min: option<f64>,
    max: option<f64>,
  }

  /// State of a door lock.
  enum lock-state {
    locked,
    unlocked,
    /// Moving towards `locked`.
    locking,
    /// Moving towards `unlocked`.
    unlocking,
    /// The bolt is stuck; the lock could not reach the requested state.
    jammed,
  }

  /// What an opener drives. Informational: every kind is the same
  /// `opener` capability and the same sensitive category to the host.
  enum opener-kind {
    garage-door,
    gate,
    door,
    window,
    other,
  }

  /// Spec for an opener (garage door, gate, motorized door or window).
  record opener-spec {
    kind: opener-kind,
    /// Whether the opener reports and accepts a `position`.
    supports-position: bool,
  }

  /// Motion state of an opener.
  enum opener-state {
    open,
    closed,
    opening,
    closing,
    /// Stopped part-way.
    stopped,
  }

  /// Current state of an opener.
  record opener-status {
    state: opener-state,
    /// 0.0 (closed) to 1.0 (fully open), when the spec sets
    /// `supports-position`. The host refuses a value outside that
    /// range or a non-finite one.
    position: option<f64>,
  }

  /// An armed mode an alarm panel supports.
  enum alarm-mode {
    armed-home,
    armed-away,
    armed-night,
    armed-vacation,
  }

  /// Spec for an alarm panel.
  record alarm-panel-spec {
    /// Armed modes the panel accepts. The host refuses an empty list
    /// or more than eight entries.
    modes: list<alarm-mode>,
    /// Whether arming or disarming needs a user code argument.
    code-required: bool,
  }

  /// State of an alarm panel.
  enum alarm-state {
    disarmed,
    armed-home,
    armed-away,
    armed-night,
    armed-vacation,
    /// Exit delay running after an arm command.
    arming,
    /// Entry delay running; the alarm triggers unless disarmed.
    pending,
    triggered,
  }

  /// Identity of a plugin-defined capability: a namespaced name plus
  /// an explicit schema version. The host refuses malformed ids at
  /// `register-device`, and the manifest declares the same identity
  /// as `"extension(<namespace>/<name>@<version>)"`.
  record extension-spec {
    /// Reverse-DNS namespace of whoever defines the extension's
    /// contract, e.g. `com.acme`. At least two dot-separated labels of
    /// `[a-z0-9][a-z0-9-]*`. Namespaces whose first label is
    /// `oxidhome` are reserved for the host.
    namespace: string,
    /// Extension name within the namespace, e.g. `window-shade`. One
    /// label of `[a-z0-9][a-z0-9-]*`.
    name: string,
    /// Major schema version, starting at 1. Bump it when the
    /// extension's state fields or commands change incompatibly;
    /// `(namespace, name, version)` is the identity consumers match on.
    version: u32,
  }

  /// What a device CAN do. Lists at registration time; describes shape, not
  /// current value. Open-ended via the `extension` arm so plugin authors
  /// can add new capability kinds without waiting for the core spec.
  ///
  /// The host derives a device's category from its capabilities.
  /// `lock`, `opener`, `alarm-panel` and `siren` make a device
  /// sensitive: commanding it needs an explicit grant for its
  /// category, and a wildcard token scope does not cover it.
  /// `video-stream` makes the device a camera, whose bytes need an
  /// explicit grant. A plugin cannot lower a category it once
  /// reported for a device by dropping the capability later.
  variant capability-spec {
    switch,
    dimmer,
    color-light(color-light-spec),
    sensor(sensor-spec),
    button,
    /// The device exposes a video stream. Plugins set up the actual stream
    /// via the streaming-plugin world's `setup-pipeline` export.
    video-stream,
    /// The device exposes an audio stream. See video-stream.
    audio-stream,
    /// A door lock. Commands: `lock`, `unlock`. State field `state`
    /// (string: a `lock-state` case name).
    lock,
    /// A garage door, gate or other motorized opening. Commands:
    /// `open`, `close`, `stop`, and `set` with a float `position` when
    /// the spec supports it. State fields `state` (string: an
    /// `opener-state` case name) and optional float `position`.
    opener(opener-spec),
    /// An alarm panel. Commands: `arm` with a string `mode` (an
    /// `alarm-mode` case name), `disarm`, and a string `pin` argument
    /// when the spec requires it (named `pin` so the host's log
    /// redaction masks it). State field `state` (string: an
    /// `alarm-state` case name).
    alarm-panel(alarm-panel-spec),
    /// A siren. Commands: `set` with a bool `state`, `toggle`. State
    /// field `state` (bool).
    siren,
    /// Plugin-defined capability, identified by namespace, name, and
    /// schema version. Consumers that don't recognize the identity
    /// simply ignore the capability.
    extension(extension-spec),
  }

  /// Current state for a stateful capability. Carried as the optional
  /// `initial-state` snapshot on `device-info` at registration time.
  /// Subsequent updates flow through `events::state-change`, which uses a
  /// looser capability-name + key-value field bag rather than this typed
  /// variant. Stateless capabilities (button, video-stream, audio-stream,
  /// extension) have no entry here.
  variant capability-state {
    switch(switchable),
    dimmer(dimmable),
    color-light(color),
    sensor(measurement),
    lock(lock-state),
    opener(opener-status),
    alarm-panel(alarm-state),
    siren(switchable),
  }
}


// ─────────────────────────────────────────────────────────────────────────
// Devices — registration, state, commands
// ─────────────────────────────────────────────────────────────────────────

interface devices {
  use types.{device-id, local-id, key-value, error, command-id};
  use capabilities.{capability-spec, capability-state};

  record device-info {
    local-id: local-id,
    /// Human-readable name. Users may override this through the host UI.
    name: string,
    /// Manufacturer / model / firmware, when known.
    manufacturer: option<string>,
    model: option<string>,
    firmware: option<string>,
    /// What the device can do. Pure shape data — current values flow
    /// through events.
    capabilities: list<capability-spec>,
    /// Optional snapshot of state at registration time, one entry per
    /// stateful capability the plugin can already report. Empty list means
    /// "state will arrive via events".
    initial-state: list<capability-state>,
    /// Free-form metadata the plugin wants persisted with the device.
    metadata: list<key-value>,
  }

  /// A command sent from the host → device (via the plugin that owns the
  /// device). Capability name + arguments. The plugin matches on
  /// capability + action.
  record command {
    /// Host-minted id of this dispatch (H5). A plugin that answers
    /// `command-result::accepted` keeps it and later reports the
    /// final result with `host-devices::complete-command`.
    id: command-id,
    /// Capability name: `"switch"`, `"dimmer"`, `"color-light"`, etc.
    capability: string,
    /// Action verb: `"set"`, `"toggle"`, `"increment"`, etc.
    action: string,
    args: list<key-value>,
  }

  /// What a plugin reports for a command (H5). The host maps each case
  /// onto the explicit outcome the caller sees: `ok` / `ok-with-state`
  /// → `completed`, `err` → `rejected`, `unknown` → `outcome-unknown`,
  /// `accepted` → `accepted`.
  variant command-result {
    /// The command took effect.
    ok,
    /// Device returned new state inline alongside the OK.
    ok-with-state(list<key-value>),
    /// The plugin refused the command **without acting** (unknown
    /// action, bad arguments, device unreachable before anything was
    /// sent). Callers may safely retry after fixing the cause. A
    /// plugin that may already have acted returns `unknown` instead.
    err(error),
    /// The plugin may have acted but cannot confirm it (for example a
    /// radio frame was sent and no acknowledgement came back). The
    /// string says why. Callers must read the device state before
    /// retrying.
    unknown(string),
    /// `execute-command` only: the plugin took the command and will
    /// report the final result later with
    /// `host-devices::complete-command`, quoting `command.id`. The host
    /// records `outcome-unknown` if no result arrives before the
    /// pending command expires. Not valid from
    /// `execute-service-command` (service commands complete
    /// synchronously; the host turns it into `unknown`) or as the
    /// argument of `complete-command`.
    accepted,
  }
}


// ─────────────────────────────────────────────────────────────────────────
// Services — non-device peers (automation scripts, virtual integrations)
//
// Mirror of the device shape: a plugin instance registers services it
// owns; commands and results reuse the `devices` `command` /
// `command-result` types so the SDK can share helpers. The driving
// use-case is the embedded scripting plugin where each user script is a
// service that exposes commands and calls into other scripts' commands.
// ─────────────────────────────────────────────────────────────────────────

interface services {
  use types.{local-id, key-value};

  /// Which `types.value` case a field carries.
  enum value-kind {
    bool-val,
    int-val,
    float-val,
    string-val,
    bytes-val,
    json-val,
  }

  /// Inclusive bounds for an `int-val` field. `none` = unbounded.
  record int-range {
    min: option<s64>,
    max: option<s64>,
  }

  /// Inclusive bounds for a `float-val` field. `none` = unbounded.
  /// Bounds must be finite; a bounded field refuses NaN.
  record float-range {
    min: option<f64>,
    max: option<f64>,
  }

  /// Restriction on a field's value. Must match the field's kind.
  variant field-constraint {
    /// `string-val` only: the value must be one of these.
    one-of(list<string>),
    /// `int-val` only.
    int-range(int-range),
    /// `float-val` only.
    float-range(float-range),
  }

  /// Machine-readable schema for one named field of a command's
  /// arguments or result.
  record field-spec {
    /// Field key, matched against `key-value.key`. 1-64 characters of
    /// `[A-Za-z0-9_-]`, starting with a letter or digit; unique within
    /// its list.
    name: string,
    kind: value-kind,
    /// Whether the field must be present.
    required: bool,
    /// Human-readable description. Informational only; never parsed.
    description: option<string>,
    constraint: option<field-constraint>,
  }

  /// Schema for one command a service exposes. The host validates it at
  /// `register-service` / `update-service`, checks every
  /// `call-service`'s `args` against `params` before dispatch
  /// (unknown, duplicate, missing-required, mistyped, or out-of-range
  /// fields are `invalid-argument`), and checks the callee's
  /// `ok-with-state` fields against `returns` before returning them.
  record command-spec {
    /// Command name, unique within the service. Same grammar as
    /// `field-spec.name`.
    name: string,
    /// Human-readable description. Informational only; never parsed.
    description: option<string>,
    /// Accepted arguments. Empty = the command takes none.
    params: list<field-spec>,
    /// Fields of an `ok-with-state` reply. Empty = the reply carries no
    /// fields: plain `ok`, an empty `ok-with-state`, or `err`.
    returns: list<field-spec>,
  }

  record service-info {
    /// Plugin-instance-local id, echoed back so the plugin can map the
    /// host-assigned `service-id` to its own bookkeeping.
    local-id: local-id,
    /// Human-readable name. Also the capability key gated by the
    /// manifest's `[capabilities] declares_services`.
    name: string,
    /// Free-form metadata persisted with the service.
    metadata: list<key-value>,
    /// Commands the service accepts. Empty ⇒ an event-only service with
    /// no callable surface.
    commands: list<command-spec>,
  }
}


// ─────────────────────────────────────────────────────────────────────────
// Events — pub/sub between plugins and the host's event bus
// ─────────────────────────────────────────────────────────────────────────

interface events {
  use types.{device-id, unix-ms, key-value, subscription-id};
  use capabilities.{button-event};

  /// Events the host delivers, or that plugins publish.
  variant event-payload {
    /// A device's state changed (sensor reading, switch flipped, etc.).
    state-changed(state-change),
    /// A momentary event from a button or scene controller.
    button(button-event),
    /// Inference results from a pipeline inference-tap.
    inference(inference-result),
    /// Plugin-defined custom event. Topic + JSON payload.
    custom(custom-event),
  }

  record state-change {
    capability: string,
    /// New values for the changed fields (partial state).
    fields: list<key-value>,
  }

  record custom-event {
    topic: string,
    /// JSON-encoded payload.
    payload: string,
  }

  /// Inference results delivered from a pipeline tap.
  /// Generic enough to carry detection bboxes, classification scores,
  /// embeddings, etc. Plugin-specific schema goes in the JSON payload.
  record inference-result {
    /// The model that produced this result (registry name).
    model: string,
    /// JSON-encoded structured output (detections, classes, embeddings).
    payload: string,
    /// Frame timestamp (unix-ms), if applicable.
    frame-timestamp: option<unix-ms>,
  }

  record event {
    /// Empty when the event isn't tied to a specific device (e.g. plugin
    /// lifecycle, custom-topic broadcast).
    device: option<device-id>,
    /// Plugin-supplied wall-clock timestamp. The host records its own
    /// receive time separately for trust-sensitive ordering and retention.
    timestamp: unix-ms,
    /// Plugin id (`plugin.id` from the publisher's manifest) that
    /// produced this event. **Host-populated on publish** — any value
    /// a plugin passes to `publish-event` is overwritten by the host
    /// before the event is durably logged or broadcast. Subscribers
    /// (WIT `on-event`, JSON `/events/tail`, Connect `Events.TailEvents`)
    /// can trust this as the immutable origin of the event.
    origin-plugin-id: string,
    /// Instance id of the plugin instance that produced this event.
    /// Same host-populated / immutable contract as `origin-plugin-id`.
    /// Together they identify the exact publisher, so a subscriber can
    /// distinguish two instances of the same plugin without ambiguity.
    origin-instance-id: string,
    /// H5: durable `event_log` row id assigned when the host persisted
    /// this event. **Host-populated on publish** — plugins can leave
    /// it `none` when calling `publish-event`; the host overwrites it
    /// before broadcasting. Subscribers use it as a monotonic cursor
    /// to reconcile after a dropped connection: save the highest
    /// observed `row-id`, resume by asking the host's history query
    /// for rows after it. `none` on events published via code paths
    /// that don't hit the durable log (unusual in production; can
    /// happen in host-side test fixtures).
    row-id: option<u64>,
    /// H6: call id (`call-<32 hex>`) of the external request this
    /// event traces back to: the publishing invocation's own call id
    /// when a token caused it, or, when an `on-event` reaction
    /// published it, the call id that reaction traces back to (so
    /// every event in a chain of reactions names the same request).
    /// `none` for work the host started on its own (`init`, `tick`). **Host-populated on publish** —
    /// any value a plugin passes is overwritten. Attribution only: an
    /// operator follows it into the audit ledger
    /// (`GET /api/v1/audit?call_id=…`); it grants nothing, and a
    /// subscriber's `on-event` runs with its own authority.
    call-id: option<string>,
    payload: event-payload,
  }

  /// A topic filter for subscriptions. Both fields optional = match all.
  record event-filter {
    /// Match this device only.
    device: option<device-id>,
    /// Match this capability only ("switch", "sensor", "inference") or
    /// custom event topic prefix.
    topic: option<string>,
  }
}


// ─────────────────────────────────────────────────────────────────────────
// Storage — small persistent KV scoped to the plugin instance
//
// Imported by every plugin world. Capability gated at the call site:
// instances without a `storage_quota_kb` declared in their manifest see
// `error::permission-denied(...)` on every call. Quota is enforced
// transactionally; over-quota writes return permission-denied.
// ─────────────────────────────────────────────────────────────────────────

interface storage {
  use types.{value, error};

  get: func(key: string) -> result<option<value>, error>;
  set: func(key: string, val: value) -> result<_, error>;
  delete: func(key: string) -> result<_, error>;
  list-keys: func(prefix: string) -> result<list<string>, error>;
}


// ─────────────────────────────────────────────────────────────────────────
// Blob store — larger byte payloads (camera snapshots, recordings, oversized
// config). Filesystem-backed on the host; this WIT is the plugin-facing
// surface.
//
// Capability-gated by the manifest's `blob_quota_mb`: 0 (or absent) means
// blob-store calls return `permission-denied` at the call site. A positive
// quota lets calls through; the host enforces total bytes used per
// instance transactionally with the index.
//
// **Phase 5b v1 ships a buffered API**: `write` takes `list<u8>` and
// `read` returns `list<u8>`. Both ends marshal the bytes through the WIT
// boundary in one shot. Fine for blobs measured in single-digit MB — the
// expected workload (per-frame snapshots, short recordings, oversized
// state). Streaming resource handles (`resource blob-writer` /
// `resource blob-reader` with `write`/`finish`/`abort` and chunked
// `read`) are the planned follow-up for plugins that want to stream
// large recordings without buffering end-to-end. The on-disk format
// doesn't change between v1 and the streaming variant — the writer
// already stages to `.tmp/<ulid>` and atomically renames on `finish`.
// ─────────────────────────────────────────────────────────────────────────

interface blob-store {
  use types.{error};

  /// Opaque host-side identifier for one stored blob. The host returns
  /// this from `write`; plugins can keep it for direct `read`s, or use
  /// the human-readable `name` they chose at write time via
  /// `read-by-name` / `delete`.
  type blob-id = string;

  /// Metadata for one stored blob. The byte payload itself is fetched
  /// via `read` / `read-by-name`; `list` returns these records so a
  /// plugin can enumerate without pulling every blob's bytes through
  /// the WIT boundary.
  record blob-info {
    name: string,
    id: blob-id,
    size-bytes: u64,
    /// Host's wall-clock at write time (`finish`), unix-ms.
    created-ms: u64,
    /// Optional MIME hint from the writer. Informational only — the
    /// host doesn't validate or use it for anything.
    mime: option<string>,
  }

  /// Write a blob in one shot. `name` is the human-readable key the
  /// plugin chose (e.g. `"snapshot-2026-05-08T10-15-00.jpg"`). Writing
  /// to an existing name overwrites it atomically (stage to `.tmp` →
  /// fsync → rename → index commit; readers always see the old blob
  /// or the new one, never a half-written file). Returns the host-
  /// minted id for the new blob.
  ///
  /// Errors: `permission-denied` when the quota would be exceeded
  /// or `blob_quota_mb` is 0 in the manifest; `internal` for
  /// filesystem / index failures.
  write: func(
    name: string,
    data: list<u8>,
    mime: option<string>,
  ) -> result<blob-id, error>;

  /// Read a blob by its host-minted id.
  ///
  /// Errors: `not-found` if the id doesn't exist in this instance's
  /// blob namespace; `internal` for filesystem failures.
  read: func(id: blob-id) -> result<list<u8>, error>;

  /// Read a blob by the user-chosen name.
  ///
  /// Errors: `not-found` if no blob with that name exists for this
  /// instance.
  read-by-name: func(name: string) -> result<list<u8>, error>;

  /// Look up metadata without fetching the byte payload.
  get-info: func(name: string) -> result<blob-info, error>;

  /// Delete a blob by name. Returns `Ok(())` whether the blob existed
  /// or not — the WIT delete contract makes no distinction.
  delete: func(name: string) -> result<_, error>;

  /// List blobs whose name starts with `prefix`. Empty prefix
  /// enumerates every blob in the instance. Named `list-blobs`
  /// because `list` is a WIT keyword.
  list-blobs: func(prefix: string) -> result<list<blob-info>, error>;
}


// ─────────────────────────────────────────────────────────────────────────
// Logging
// ─────────────────────────────────────────────────────────────────────────

interface logging {
  enum level { trace, debug, info, warn, error }
  log: func(level: level, message: string);
}


// ─────────────────────────────────────────────────────────────────────────
// Media — pipeline descriptions for streaming plugins
//
// The principle: WASM plugins describe media pipelines; the host runs them
// natively. This keeps codec work out of WASM (where it would be slow and
// can't reach hardware accelerators) while letting plugins handle the
// fiddly proprietary protocol parts where Rust-in-WASM shines.
// ─────────────────────────────────────────────────────────────────────────

/// Media pipeline descriptions.
///
/// Native media runs inside the host process with strict limits
/// (docs/adr/0002-in-process-native-media-and-inference.md). So every
/// field the host acts on is typed and bounded: there are no free-form
/// URLs, no local-file sources, no filesystem paths, and no free-form
/// codec or filter names. The host validates a whole `media-pipeline`
/// before any native code sees it and rejects a violation with
/// `error::invalid-argument(...)`; a well-formed request for something
/// this host build can't do (e.g. an encoder it lacks) returns
/// `error::unavailable(...)`.
interface media {
  use types.{error};

  /// Reference to a credential the host holds. A plugin never puts a
  /// username or password into a pipeline description: it names the
  /// config keys that hold them, and the host reads those values only
  /// when it opens the connection. Secrets therefore never appear in
  /// pipeline descriptions, host logs, or events.
  ///
  /// Both keys name fields of this plugin instance's configuration (the
  /// values `host-config` returns). Each must resolve to a
  /// `value::string-val`; anything else fails the pipeline with
  /// `error::invalid-argument(...)`.
  record credential-ref {
    username-key: string,
    password-key: string,
  }

  /// Transport security for a `network-endpoint`. Together with the
  /// `media-source` case this fixes the scheme: `rtsp` + `plain` is
  /// `rtsp://`, `rtsp` + `tls` is `rtsps://`, `http` + `plain` is
  /// `http://`, `http` + `tls` is `https://`.
  enum transport-security {
    plain,
    /// TLS, with the server certificate verified against the host's
    /// trust store. There is no "skip verification" mode.
    tls,
  }

  /// A network location the host connects to on the plugin's behalf.
  /// The host builds the URL from these parts itself; a plugin can't
  /// smuggle a scheme, userinfo, or a second authority into it.
  record network-endpoint {
    security: transport-security,
    /// DNS name (LDH labels, at most 253 bytes, last label not a decimal
    /// or `0x` hex number) or IP literal, with IPv6 written without
    /// brackets or zone id. No scheme, userinfo, port, or path.
    host: string,
    /// TCP port. `none` uses the scheme default (554 for `rtsp://`,
    /// 322 for `rtsps://`, 80 for `http://`, 443 for `https://`).
    /// Port 0 is rejected.
    port: option<u16>,
    /// Absolute path with an optional `?query`, starting with `/`. At
    /// most 2048 bytes; no whitespace, control characters, or `#`
    /// fragment.
    path: string,
    /// Credentials the host applies (RTSP/HTTP basic or digest auth).
    credential: option<credential-ref>,
  }

  /// A source of media bytes.
  ///
  /// **Network policy for `rtsp` / `http`.** The host resolves `host`
  /// itself and checks every resolved address before it connects, then
  /// connects to the address it checked (no second lookup, so DNS
  /// rebinding can't swap it). It repeats the check on every redirect
  /// hop, follows at most 5 redirects, never lets a redirect leave the
  /// source's own protocol family (`http` may go to `https`, never to
  /// another scheme), and never follows one from TLS to plaintext. The
  /// check:
  ///
  /// - always denies unspecified, broadcast, multicast, and reserved
  ///   addresses (for IPv6, anything outside global unicast `2000::/3`
  ///   and the classes below, plus special-purpose blocks inside it);
  /// - denies loopback, link-local, and private addresses (RFC 1918,
  ///   100.64.0.0/10 shared address space, IPv6 unique-local) unless the
  ///   plugin's manifest grant allows that address class;
  /// - classifies IPv6 addresses that carry an IPv4 address (IPv4-mapped,
  ///   NAT64 `64:ff9b::/96`, 6to4 `2002::/16`) by that IPv4 address.
  ///
  /// Local cameras normally sit on a private network, so camera plugins
  /// ask for the private-address grant at install time and the user
  /// approves it.
  ///
  /// There is no local-file source: the host never opens a filesystem
  /// path on a plugin's behalf.
  variant media-source {
    /// RTSP (`rtsp://` or `rtsps://`).
    rtsp(network-endpoint),
    /// HTTP (`http://` or `https://`), e.g. MJPEG-over-HTTP or HLS
    /// pulled from a camera.
    http(network-endpoint),
    /// Plugin produces bytes via a host-managed pipe. Used for proprietary
    /// protocols where the plugin must do auth/decryption/re-framing
    /// before bytes can enter a standard pipeline.
    plugin-pipe(plugin-pipe-config),
  }

  /// Video codecs the host pipeline knows. Adding one is a contract
  /// change; the allowlist is the enum.
  enum video-codec { h264, h265, vp8, vp9, av1, mjpeg }

  /// Audio codecs the host pipeline knows. `pcm-s16le` is raw
  /// little-endian signed 16-bit PCM; `pcm-mulaw` / `pcm-alaw` are G.711.
  enum audio-codec { aac, opus, pcm-s16le, pcm-mulaw, pcm-alaw, g722 }

  /// The codec of one elementary stream.
  variant media-codec {
    video(video-codec),
    audio(audio-codec),
  }

  /// Framing of the bytes a plugin writes into a `pipe-writer`.
  enum pipe-format {
    /// RTP packets, one per `pipe-writer.write` call.
    rtp,
    /// MPEG transport stream (188-byte packets).
    mpeg-ts,
    /// Bare elementary stream of the declared codec (H.264/H.265
    /// Annex B, concatenated JPEG frames for MJPEG, raw PCM, ...).
    elementary-stream,
  }

  record plugin-pipe-config {
    /// Framing the plugin will emit.
    format: pipe-format,
    /// Codec inside that framing.
    codec: media-codec,
    /// RTP clock rate in Hz. Required when `format` is `rtp`; ignored
    /// otherwise.
    clock-rate: option<u32>,
    /// Audio sample rate in Hz (8000–192000). Audio codecs only.
    sample-rate: option<u32>,
    /// Audio channel count (1–8). Audio codecs only.
    channels: option<u8>,
  }

  /// Container formats the host can demultiplex.
  enum container-format {
    rtp,
    mpeg-ts,
    matroska,
    mp4,
    flv,
    /// `multipart/x-mixed-replace` JPEG streams (MJPEG over HTTP).
    multipart-jpeg,
  }

  /// A pipeline step the host should apply after the source.
  variant pipeline-step {
    /// Demux/depacketize the given container.
    demux(container-format),
    /// Decode the video. Host may use hardware acceleration.
    decode-video,
    /// Re-encode video to a target codec (used when consumer needs
    /// different codec).
    encode-video(encode-params),
    /// Transcode audio.
    transcode-audio(audio-params),
    /// Apply a per-frame video filter.
    filter(video-filter),
    /// Tap the pipeline to feed frames into a host-managed ML model.
    /// Inference results are delivered to the plugin as events.
    inference-tap(inference-tap-config),
  }

  record encode-params {
    codec: video-codec,
    /// Target bitrate, 16–100000 kbit/s. `none` lets the host choose.
    bitrate-kbps: option<u32>,
    /// Frames between keyframes, 1–1000. `none` lets the host choose.
    keyframe-interval: option<u32>,
  }

  record audio-params {
    codec: audio-codec,
    /// Sample rate in Hz (8000–192000). `none` keeps the source rate.
    sample-rate: option<u32>,
    /// Channel count (1–8). `none` keeps the source layout.
    channels: option<u8>,
  }

  /// A frame size in pixels. Each side is 1–8192.
  record frame-size {
    width: u32,
    height: u32,
  }

  /// A crop rectangle in pixels, relative to the incoming frame. The
  /// host rejects a rectangle that doesn't fit inside the frame.
  record crop-rect {
    x: u32,
    y: u32,
    width: u32,
    height: u32,
  }

  /// Clockwise rotation.
  enum rotation { rotate90, rotate180, rotate270 }

  /// Per-frame video filters. The allowlist is the variant: there is no
  /// way to name an arbitrary native filter.
  variant video-filter {
    /// Scale to the given size (aspect ratio not preserved).
    scale(frame-size),
    crop(crop-rect),
    rotate(rotation),
    /// Drop frames to at most this many per second. Finite, greater
    /// than 0 and at most 120.
    max-framerate(f32),
  }

  /// Configuration for an in-pipeline inference tap.
  /// All per-frame work happens natively. The plugin only sees the
  /// (small) structured inference output as events.
  record inference-tap-config {
    /// Model registry name. Same grammar as `inference.load-model`'s
    /// `name`, and the model must be one the plugin's manifest declares.
    model: string,
    /// Optional version pin. None = latest compatible. Same grammar as
    /// `inference.load-model`'s `version`.
    model-version: option<string>,
    /// Sample rate in frames per second. Finite, greater than 0 and at
    /// most 120. None = match source framerate.
    fps: option<f32>,
    /// Where in the pipeline to tap.
    tap-point: tap-point,
    /// Event topic to publish results under.
    event-topic: string,
    /// Optional preprocessing applied by the host before inference. At
    /// most 8 steps.
    preprocessing: list<preprocessing-step>,
  }

  enum tap-point {
    /// After decode — raw decoded frames available. Normal choice for
    /// vision.
    post-decode,
    /// After all filtering steps. Used when filtering changes what the
    /// model sees.
    post-filter,
  }

  variant preprocessing-step {
    /// Resize to the given size.
    resize(frame-size),
    /// Letterbox to the given size — preserves aspect ratio with padding.
    letterbox(frame-size),
    /// Per-channel normalize with (mean, std). Both finite; std non-zero.
    normalize(tuple<f32, f32>),
    to-rgb,
    to-bgr,
  }

  /// Logical name of an output sink. 1–64 characters from `a-z`, `0-9`,
  /// `-`, and `_`, starting with a letter or digit. It is never a path:
  /// the host places it inside this plugin instance's own namespace
  /// (`<plugin-id>/<instance-id>/<sink-name>` for RTSP and HLS), so
  /// plugins can't collide with each other or reach outside their
  /// namespace.
  type sink-name = string;

  /// Name of a recording profile the operator configured on the host.
  /// Same grammar as `sink-name`. The profile, not the plugin, decides
  /// where and how recordings are stored.
  type recording-profile = string;

  /// What the host should expose this stream as, downstream.
  variant output-sink {
    /// Mount on the host's RTSP server under the instance namespace.
    rtsp(sink-name),
    /// The host adds a WebRTC track for on-demand peers.
    webrtc,
    /// Mount on the host's HLS server under the instance namespace.
    hls(sink-name),
    /// Record to host-managed storage using the named profile.
    record-to-storage(recording-profile),
  }

  enum activation-policy {
    /// Pipeline runs only when a consumer is watching.
    on-demand,
    /// Pipeline runs continuously (recording, motion detection).
    always,
    /// Pipeline runs when motion is signaled (linked motion detector).
    motion-triggered,
  }

  /// Full pipeline description the plugin hands to the host. At most 32
  /// `steps` and 8 `sinks`.
  record media-pipeline {
    source: media-source,
    steps: list<pipeline-step>,
    sinks: list<output-sink>,
    activation: activation-policy,
  }

  /// A handle to a running pipeline the host owns.
  resource pipeline-handle {
    stop: func();
    update: func(pipeline: media-pipeline) -> result<_, error>;
  }

  /// A writer for a plugin-pipe source. Plugin writes pre-framed bytes
  /// into this; the host's pipeline consumes them.
  resource pipe-writer {
    /// Write a chunk of pre-framed bytes (matching the format declared in
    /// the plugin-pipe-config). At most 1 MiB per call. Returns bytes
    /// written.
    write: func(data: list<u8>) -> result<u64, error>;
    /// Signal end-of-stream and close.
    close: func();
  }
}


// ─────────────────────────────────────────────────────────────────────────
// Inference — host-managed ML model access for AI plugins
//
// Models are first-class platform resources, not application code. The
// host loads, runs, and accelerates them; plugins request inference and
// orchestrate around the results. Capability gated at the call site by
// the manifest's declared model dependencies.
// ─────────────────────────────────────────────────────────────────────────

/// Host-managed ML inference.
///
/// Inference runs inside the host process with strict limits
/// (docs/adr/0002-in-process-native-media-and-inference.md). The host
/// checks every tensor against the limits below — with overflow-checked
/// arithmetic — before it reaches the native runtime, and applies the
/// same limits to the tensors a model returns before copying them into
/// the guest. A violation returns `error::invalid-argument(...)`.
///
/// Tensor limits:
/// - rank (number of dimensions): at most 8;
/// - every dimension: at least 1;
/// - elements per tensor (product of the shape): at most 67_108_864 (2^26);
/// - bytes per tensor: exactly elements × element width, at most 64 MiB;
/// - per `infer` call: at most 16 tensors and 256 MiB of tensor data,
///   for the inputs and, separately, for the outputs.
interface inference {
  use types.{error};

  /// Tensor element type. Element widths: `f32` / `i32` 4 bytes, `f16`
  /// 2 bytes, `i8` / `u8` 1 byte, `i64` 8 bytes.
  enum tensor-dtype { %f32, %f16, %i8, %u8, %i32, %i64 }

  /// One dimension of a model's declared tensor shape.
  variant tensor-dim {
    /// A fixed size (at least 1).
    fixed(u32),
    /// Any size, chosen by the caller per call (e.g. batch size).
    dynamic,
  }

  record tensor-spec {
    name: string,
    /// Declared shape; at most 8 dimensions.
    shape: list<tensor-dim>,
    dtype: tensor-dtype,
  }

  record named-tensor {
    /// Name from the model's `tensor-spec` list.
    name: string,
    /// Concrete shape: at most 8 dimensions, each at least 1, matching
    /// the model's `tensor-spec` (fixed dimensions exactly).
    shape: list<u32>,
    dtype: tensor-dtype,
    /// Raw bytes, row-major, little-endian. Length must equal the
    /// element count × the dtype's width, at most 64 MiB (see the
    /// `inference` interface limits).
    data: list<u8>,
  }

  /// Execution provider a loaded model runs on. The host never falls
  /// back silently: if a model can't run where it was configured to,
  /// `load-model` fails.
  enum execution-provider { cpu, cuda, tensorrt, core-ml, openvino, rocm }

  record model-info {
    name: string,
    version: string,
    inputs: list<tensor-spec>,
    outputs: list<tensor-spec>,
    runtime: execution-provider,
  }

  /// A handle to a loaded model. Capability-scoped: plugin can only hold
  /// handles for models its manifest authorizes.
  resource model {
    /// Run inference on a single input set (or batch).
    /// Tensors are matched by name to the model's signature. At most 16
    /// tensors and 256 MiB of tensor data in each direction.
    infer: func(inputs: list<named-tensor>) -> result<list<named-tensor>, error>;
    /// Model metadata.
    info: func() -> model-info;
  }

  /// Plugin asks the host to load a model from the registry.
  /// Returns a handle the plugin uses for inference.
  ///
  /// `name` is a registry name: 1–64 characters from `a-z`, `0-9`, `-`,
  /// and `_`, starting with a letter or digit. `version` is 1–32
  /// characters from `A-Z`, `a-z`, `0-9`, `.`, `+`, and `-`, starting
  /// with a letter or digit and never containing `..`. Neither is ever
  /// used as a filesystem path.
  load-model: func(name: string, version: option<string>) -> result<model, error>;
}


// ─────────────────────────────────────────────────────────────────────────
// Host imports — split by concern so plugin worlds compose only what they
// can use. Capability is gated at the call site (see header comment).
// ─────────────────────────────────────────────────────────────────────────

/// Device lifecycle: announce devices the plugin manages, look them up.
interface host-devices {
  use types.{device-id, error, command-id};
  use devices.{device-info, command-result};

  register-device: func(info: device-info) -> result<device-id, error>;
  update-device:   func(id: device-id, info: device-info) -> result<_, error>;
  remove-device:   func(id: device-id) -> result<_, error>;
  /// Look up a device the plugin previously registered. Returns
  /// `error::not-found(...)` if the id is unknown to this plugin.
  get-device:      func(id: device-id) -> result<device-info, error>;
  /// Report the final result of a command this instance answered with
  /// `command-result::accepted` (H5). Each accepted command completes
  /// at most once. `ok-with-state` is projected into the device state
  /// exactly as a synchronous reply would be.
  ///
  /// Errors: `invalid-argument` if `reply` is `accepted`; `not-found`
  /// if `id` is not a pending command of this instance (never
  /// accepted, already completed, or expired, in which case the host
  /// already recorded `outcome-unknown`).
  complete-command: func(id: command-id, reply: command-result) -> result<_, error>;
}

/// Service lifecycle + synchronous cross-plugin dispatch (Phase 7).
/// Owner-scoped read/write mirrors `host-devices`: a plugin can only
/// manage services it registered. `register-service` is gated by the
/// manifest's `[capabilities] declares_services`.
interface host-services {
  use types.{service-id, key-value, error};
  use services.{service-info};
  use devices.{command-result};

  /// Register a new service. H10: `local-id` on `service-info` is
  /// the **immutable logical key** for the service; the host
  /// refuses a registration whose `(instance, local-id)` collides
  /// with an already-registered service in the same instance
  /// (`invalid-argument`). Callers of `resolve-service` /
  /// `call-service` address the service by this key, and no
  /// downstream call can mutate it.
  register-service: func(info: service-info) -> result<service-id, error>;
  /// Replace an already-registered service's info. H10: `local-id`
  /// is immutable — a call whose `info.local-id` differs from the
  /// currently-registered value returns `invalid-argument` and the
  /// registry is not mutated. Callers persist `local-id` as part
  /// of their target address; changing it would silently invalidate
  /// every persisted address.
  update-service:   func(id: service-id, info: service-info) -> result<_, error>;
  remove-service:   func(id: service-id) -> result<_, error>;
  /// Look up a service the plugin previously registered. Returns
  /// `error::not-found(...)` if the id is unknown to this plugin.
  get-service:      func(id: service-id) -> result<service-info, error>;

  /// H10: stable resolution by logical address
  /// `(plugin-id, instance-id, service-local-id)`. `service-id`
  /// values are per-run — the host mints a fresh `svc-N` on every
  /// register — so a caller cannot persist a `service-id` and
  /// expect it to resolve across a restart. All three parts of
  /// the logical address are stable across restarts:
  ///
  /// - `plugin-id` — fixed by the callee's `plugin.id` manifest field.
  /// - `instance-id` — the operator-chosen instance name passed to
  ///   `Engine::start_instance`; already keys per-instance KV /
  ///   blob storage.
  /// - `service-local-id` — the plugin's own bookkeeping id
  ///   (`service-info.local-id`), immutable per registration.
  ///
  /// **Uses `local-id`, not `name`.** `service-info.name` is
  /// documented as human-readable and can change under
  /// `update-service`; using it as a persistent address key would
  /// silently break resolution after a rename. `local-id` cannot
  /// change (see `register-service` / `update-service`).
  ///
  /// **Resolution does not imply the caller may then invoke the
  /// service.** `call-service` runs its own authorization against
  /// the caller's `[capabilities] consumes_services` grants, on
  /// the immutable `local-id`, and per-command.
  ///
  /// Errors: `not-found` if no live service matches all three
  /// components of the address.
  resolve-service: func(
    plugin-id: string,
    instance-id: string,
    service-local-id: string,
  ) -> result<service-id, error>;

  /// Synchronously call another plugin's service command. The host
  /// routes `target` → owning instance, races its
  /// `execute-service-command` export against a timeout, and
  /// returns the result. The callee's `command-result::unknown` is
  /// passed through; `accepted` is never returned (a callee that
  /// answers `accepted` is reported as `unknown`).
  ///
  /// **Caller-side capability gate (H10).** The dispatcher
  /// authorizes the call against the caller's structured
  /// `[capabilities] consumes_services` grants. A grant entry is
  /// `{plugin, instance (or "*"), service (local-id), commands (or
  /// ["*"]), caller_instance (or "*")}`. The call is authorized
  /// when **at least one entry in the plugin-declared *requested*
  /// list AND at least one entry in the operator's *granted* copy
  /// each match** the target's `plugin`, `instance`,
  /// `service.local-id`, the exact `command` name (or the entry
  /// lists `"*"` in `commands`), and the caller's own instance-id
  /// (or the entry's `caller_instance` is `"*"`). This is
  /// requested ∧ granted, applied per call — the granted copy
  /// does **not** override the requested list; both are
  /// consulted, so the manifest still acts as a ceiling on what
  /// the plugin can be authorized to invoke.
  ///
  /// **Root authority (H6).** When the invocation making the call
  /// is rooted at an external request (a token's command or service
  /// call, and every call-service hop it leads to), the call also
  /// needs that request's own permission for `service.call` on the
  /// target, and none of its denies may match. A plugin's grant
  /// never extends what the requester may do. Work the host started
  /// (`init`, `tick`, and every `on-event`, including a reaction to
  /// an event whose `call-id` names a request) is decided by the
  /// plugin's grants alone: an event attributes, it doesn't
  /// delegate.
  ///
  /// Because the authorization key is the service's immutable
  /// `local-id`, a callee that renames its service via
  /// `update-service` cannot silently shadow a grant. The
  /// `caller_instance` axis lets an operator scope a grant to
  /// specific caller instances, so one instance of a
  /// multi-instance caller plugin doesn't authorize every
  /// instance.
  ///
  /// **Same-instance dispatch is not supported.** A supervisor
  /// task drives exactly one wasm store; routing back through the
  /// host to a service the caller's own instance owns would queue
  /// an `ExecuteService` message to a supervisor already parked on
  /// the caller — deadlock by construction. The host rejects such
  /// calls up-front with `invalid-argument`. Plugins that colocate
  /// multiple services in one instance dispatch between them in
  /// plugin-local code; scripting plugins run each script in its own
  /// sandbox (`host-sandboxes`), so scripts call each other here.
  ///
  /// **Queued vs started.** The call waits in the callee instance's
  /// queue until that instance is free, and is then started. The
  /// outcome of a call that doesn't finish normally depends on which
  /// side of that line it ended on:
  ///
  /// - **Still queued.** If the timeout passes before the callee
  ///   started the call, or the callee refuses it (stopped, or
  ///   restarting), the call did not run and never will: the result
  ///   is `err(unavailable)`, and retrying is safe. A call still queued
  ///   when the callee restarts may instead run in its next life.
  /// - **Started.** If the callee traps, is stopped, or the timeout
  ///   passes after it started the call, the result is
  ///   `ok(command-result::unknown)`: the callee may have acted, so
  ///   read its state before retrying. A reply the callee produces
  ///   after the caller stopped waiting is not returned; for an
  ///   invocation that started outside the host (API, MCP), it is
  ///   recorded in the host's audit trail.
  ///
  /// Errors: `not-found` (no such service); `permission-denied`
  /// (no matching entry in the caller's `consumes_services`
  /// grants, or the originating request may not make this call); `invalid-argument` (same-instance target, A→…→A
  /// cycle, a command the service's `command-spec` list doesn't
  /// declare, or `args` that violate its `params` schema);
  /// `internal` (the callee's `ok-with-state` reply violates the
  /// command's `returns` schema); `unavailable` (owner not
  /// running, or the call ended before the callee started it).
  call-service: func(
    target: service-id,
    command: string,
    args: list<key-value>,
  ) -> result<command-result, error>;
}

/// One sandbox per script (ADR-0001). A scripting plugin runs each user
/// script in its own child instance: same component, same manifest, its
/// own Wasmtime store and supervisor. Script-to-script calls are then
/// ordinary cross-instance `host-services::call-service` calls, with the
/// host's grants, deadlines, cycle checks and audit.
///
/// Gated by the manifest's `[capabilities] script_sandboxes` (the number
/// of sandboxes one instance may run at once; `0` refuses
/// `start-sandbox` with `permission-denied`). Sandboxes don't nest.
interface host-sandboxes {
  use types.{error};

  /// A live sandbox.
  record sandbox-info {
    /// The script's id, unique within its parent instance: 1-64 bytes
    /// of `[a-z0-9_-]`, starting with a letter or digit.
    local-id: string,
    /// The sandbox's instance id, `<parent-instance>~<local-id>`. This
    /// is the id other plugins resolve its services under and that
    /// `consumes_services` grants match.
    instance-id: string,
    /// The instance that started the sandbox.
    parent-instance: string,
  }

  /// What a sandbox runs, as returned by `current-sandbox`.
  record sandbox-script {
    info: sandbox-info,
    /// The source passed to `start-sandbox`.
    source: string,
  }

  /// Start a sandbox running `source` and return its instance id. The
  /// call returns once the sandbox's supervisor is spawned and doesn't
  /// wait for its `init`. Starting a live `local-id` again with the same
  /// source returns the existing instance id.
  ///
  /// Errors: `permission-denied` (`script_sandboxes` is 0 or the caller
  /// is itself a sandbox); `invalid-argument` (bad `local-id`, source
  /// over 64 KiB, the resulting instance id too long, or a live
  /// `local-id` with different source); `unavailable` (the instance's
  /// sandbox limit is reached, a previous sandbox with this `local-id`
  /// is still stopping or its storage is still being purged, the host
  /// is shutting down, or this instance isn't supervised).
  start-sandbox: func(local-id: string, source: string) -> result<string, error>;

  /// Stop a sandbox this instance started and remove it: its storage
  /// is purged. It leaves the list at once and stops in the
  /// background; until its storage is purged it still counts against
  /// `script_sandboxes` and its `local-id` can't be started again.
  /// Errors: `not-found`; `permission-denied` inside a sandbox;
  /// `unavailable` in an instance the host doesn't supervise;
  /// `internal` if the removal couldn't be recorded (the sandbox still
  /// stops).
  stop-sandbox: func(local-id: string) -> result<_, error>;

  /// The sandboxes this instance started that are still live.
  list-sandboxes: func() -> list<sandbox-info>;

  /// Inside a sandbox: the script it runs. `none` in any other instance.
  current-sandbox: func() -> option<sandbox-script>;
}

/// Event bus pub/sub. Subscribed events are delivered via the plugin's
/// exported `on-event(...)`; `read-events` replays the same events
/// from the host's durable history.
interface host-events {
  use types.{subscription-id, error};
  use events.{event, event-filter};

  publish-event: func(ev: event) -> result<_, error>;
  subscribe:     func(filter: event-filter) -> result<subscription-id, error>;
  unsubscribe:   func(id: subscription-id) -> result<_, error>;

  /// One page of `read-events`.
  record event-page {
    /// Visible events with `row-id` above the request's `after-id`,
    /// oldest first. Every event carries its `row-id`.
    events: list<event>,
    /// The cursor for the next call. It can be past the last returned
    /// event, because rows this plugin may not see are skipped. Store
    /// it (for example in `storage`) to resume after a restart.
    next-after-id: u64,
    /// Highest row id in history when the page was read. The plugin
    /// has caught up when `next-after-id >= head-id`.
    head-id: u64,
  }

  /// `after-id` can't be resumed without a gap: the rows right after
  /// it were deleted by retention, or it is above the history head
  /// (for example after the host restored an older backup). Resume
  /// from `head-id` and rebuild what you track from `host-state`.
  record cursor-expired {
    after-id: u64,
    /// Oldest row id still in history; `none` if history is empty.
    oldest-id: option<u64>,
    /// Highest row id ever assigned.
    head-id: u64,
  }

  variant event-read {
    page(event-page),
    cursor-expired(cursor-expired),
  }

  /// Read recorded events with `row-id > after-id`, oldest first: the
  /// events `on-event` would have delivered to this instance's
  /// current subscriptions, plus host gap markers (topic
  /// `host.event_log.gap`), which every reader sees. `0` starts at
  /// the oldest retained row. Rows matching no current subscription
  /// are skipped without saying why, so subscribe before reading. A
  /// recorded row the host can no longer decode is skipped too (and
  /// logged on the host).
  ///
  /// Needs `capabilities.subscribes_events`; without it the call is
  /// `permission-denied`. `bytes-val` fields are replaced by a
  /// `json-val` marker
  /// `{"withheld":"bytes","size_bytes":N,"required_scope":"reads_event_bytes"}`
  /// unless the manifest requests `capabilities.reads_event_bytes`
  /// and the operator's grant for the installation keeps it.
  ///
  /// A page holds at most `limit` events (0 means 64; capped at 256)
  /// and about 1 MiB, and one call looks at a bounded number of rows,
  /// so a page can be short or empty before the plugin has caught up:
  /// keep reading from `next-after-id` until it reaches `head-id`.
  read-events: func(after-id: u64, limit: u32) -> result<event-read, error>;
}

/// Per-instance configuration the user set for this plugin instance.
interface host-config {
  use types.{value, key-value, error};

  /// Look up a single config value.
  get-config:  func(key: string) -> result<option<value>, error>;
  list-config: func() -> result<list<key-value>, error>;
}

/// Read access to the host-owned device-state projection (H2): the
/// current value of each capability of each device, as the host
/// last recorded it.
///
/// A plugin can always read the devices it registered itself. Reading
/// another instance's devices needs a matching
/// `[[capabilities.reads_state]]` grant (owner plugin, capability,
/// device); without one, `get-state` answers `not-found` (the same as
/// for an unknown device) and `list-state` leaves those entries out. `bytes-val` fields are
/// replaced by a `json-val` marker
/// `{"withheld":"bytes","size_bytes":N,"required_scope":"reads_state.bytes"}`
/// unless the matching grant sets `bytes = true`; a plugin's own
/// entries are returned as written. Refused reads are recorded in the
/// host's audit ledger.
interface host-state {
  use types.{device-id, unix-ms, key-value, error};

  /// `fresh` while the owning instance runs and has reported the
  /// value in its current life. `stale` when the owner stopped, the
  /// device or capability was removed, or the value was restored
  /// after a host restart and not yet republished.
  enum state-quality {
    fresh,
    stale,
  }

  /// The current value of one capability on one device.
  record device-state {
    device: device-id,
    capability: string,
    /// Merged current fields (every key reported so far, latest value).
    fields: list<key-value>,
    /// Store-wide revision at which this value was written. Higher
    /// means newer; comparable across devices.
    revision: u64,
    /// Host clock when the value was recorded.
    received-ms: unix-ms,
    /// Owner-supplied observation time; informational only.
    observed-ms: unix-ms,
    quality: state-quality,
  }

  /// Both fields optional; `none` matches everything.
  record state-filter {
    device: option<device-id>,
    capability: option<string>,
  }

  /// One page of `list-state`.
  record state-page {
    /// Store revision at the time of the read.
    revision: u64,
    /// Visible entries, grouped by device (sorted by device id, then
    /// capability).
    entries: list<device-state>,
    /// Opaque cursor for the next page; `none` once the scan reached
    /// the end. Valid only in this host process.
    next-cursor: option<string>,
  }

  /// Every visible capability entry of `device`. `not-found` when
  /// none is visible: the host has no state for it, or none of it is
  /// visible to this plugin (the two are not told apart, so a plugin
  /// can't learn which device ids exist).
  get-state: func(device: device-id) -> result<list<device-state>, error>;

  /// Visible entries matching `filter`, from the start (`cursor` is
  /// `none`) or from a previous page's `next-cursor`, at most `limit`
  /// devices per page (0 means 64; capped at 256) and about 1 MiB.
  /// One call looks at a bounded number of entries, so a page can
  /// hold fewer devices than `limit`, or none, while `next-cursor` is
  /// still set: keep reading until it is `none`. A cursor from an
  /// earlier host process is `invalid-argument`; start over.
  list-state: func(
    filter: state-filter,
    cursor: option<string>,
    limit: u32,
  ) -> result<state-page, error>;
}

/// Media pipeline orchestration. Imported only by the streaming worlds —
/// reachability is what gives the standard `plugin` world its no-raw-I/O
/// guarantee. Capability is still gated by the manifest at the call site.
interface host-media {
  use types.{device-id, error};
  use media.{media-pipeline, pipeline-handle, plugin-pipe-config, pipe-writer};

  /// Hand a pipeline description to the host. Host runs it natively.
  start-pipeline: func(
    device: device-id,
    pipeline: media-pipeline,
  ) -> result<pipeline-handle, error>;

  /// Open a writer for a plugin-pipe source. Used when the plugin produces
  /// re-framed bytes from a proprietary protocol.
  open-pipe: func(
    config: plugin-pipe-config,
  ) -> result<pipe-writer, error>;
}


// ─────────────────────────────────────────────────────────────────────────
// Worlds — what kinds of plugins can exist
// ─────────────────────────────────────────────────────────────────────────

/// Standard plugin world. Most plugins (switches, sensors, hubs, automation
/// rules) use this. No raw I/O — communication is via the event bus and
/// the split host-* imports.
world plugin {
  import host-devices;
  import host-events;
  import host-config;
  import host-state;
  import host-services;
  import host-sandboxes;
  import storage;
  import blob-store;
  import logging;

  use types.{device-id, service-id, key-value};
  use devices.{command, command-result};
  use events.{event};

  // Lifecycle. `on-shutdown`, not `shutdown`: a bare `shutdown` core
  // export collides with wasi-libc's socket `shutdown` symbol.
  export init: func() -> result<_, string>;
  export on-shutdown: func();

  // Event delivery from the host's bus to the plugin
  export on-event: func(ev: event);

  // Commands targeting devices the plugin owns. `cmd.id` is the
  // host-minted command id (H5); see `command-result` for how each
  // reply maps onto the caller-visible outcome.
  export execute-command: func(
    device: device-id,
    cmd: command,
  ) -> command-result;

  // Commands targeting services the plugin owns (Phase 7). Invoked by
  // the host dispatcher when another plugin (or this one) calls
  // `host-services::call-service` against one of this plugin's services.
  // Plugins that expose no services return `command-result::err(...)`.
  // Service commands complete synchronously: `accepted` is not valid
  // here and the host reports it to the caller as `unknown`.
  export execute-service-command: func(
    service: service-id,
    command: string,
    args: list<key-value>,
  ) -> command-result;

  // Optional periodic tick for plugins that poll. Host calls based on the
  // plugin manifest's requested interval. Plugins that don't need it can
  // return immediately.
  export tick: func();
}

/// Exports unique to the streaming world, packaged as an interface so the
/// world can `export streaming` without re-`use`-ing types that the
/// `include plugin` already pulled in (which would shadow).
interface streaming {
  use types.{device-id};
  use media.{media-pipeline};

  /// Plugin sets up its media pipeline(s) for a given device. Called by
  /// the host after device registration when streaming is needed.
  setup-pipeline: func(device: device-id) -> result<media-pipeline, string>;
}

/// Streaming plugin world — extends the standard world with WASI
/// sockets/HTTP and host-media for cameras, voice assistants, network
/// bridges. Only instances whose manifest selects a streaming world get
/// these imports linked.
///
/// Importing them doesn't grant network access. The host checks every
/// TCP connect, UDP send, name lookup and outgoing HTTP request against
/// the instance's granted `[capabilities] network` rules, on the resolved
/// IP address; with no matching rule the call fails with `access-denied`
/// (sockets, name lookup) or `HTTP-request-denied` (HTTP). Names are
/// resolved by the host, and a name rule covers the public addresses the
/// name resolved to; a name rule under `.local`, `.lan`, `.home.arpa` or
/// `.internal` also covers private ones. Other private addresses, and all
/// loopback and link-local ones, need an IP or CIDR rule inside that
/// range. Binds are allowed only to the
/// unspecified address; `listen` is refused. `wasi:http` does not follow
/// redirects, so each hop is a new, separately checked request.
world streaming-plugin {
  include plugin;
  import host-media;
  import wasi:sockets/instance-network@0.2.0;
  import wasi:sockets/network@0.2.0;
  import wasi:sockets/tcp-create-socket@0.2.0;
  import wasi:sockets/tcp@0.2.0;
  import wasi:sockets/udp-create-socket@0.2.0;
  import wasi:sockets/udp@0.2.0;
  import wasi:sockets/ip-name-lookup@0.2.0;
  import wasi:http/outgoing-handler@0.2.0;
  import wasi:clocks/monotonic-clock@0.2.0;
  export streaming;
}

/// AI plugin world — adds inference without streaming, for plugins that
/// run ML on sensor data, anomaly detection, etc.
world ai-plugin {
  include plugin;
  import inference;
}

/// Streaming + AI plugin world — combines streaming I/O with ML model
/// access (e.g., a camera plugin that orchestrates person detection).
world streaming-ai-plugin {
  include streaming-plugin;
  import inference;
}
